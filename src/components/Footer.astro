---
import { studio } from "../data/studio";
import { navLinks } from "../data/nav";

const { address, foundation, instagram, facebook } = studio;

// Build-time year. The site is rebuilt on every deploy, so it stays current.
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container columns">
    <div class="column">
      <span class="logo-name">BLOOM</span>
      <span class="logo-tagline">studio by Dayana</span>
      <span class="address">{address.street}, {address.town}</span>
      <a href={studio.phoneHref}>{studio.phone}</a>
      <a href={studio.emailHref}>{studio.email}</a>
    </div>

    <nav class="column pages" aria-label="Strony">
      {navLinks.map(({ href, label }) => <a class="page-link" href={href}>{label}</a>)}
    </nav>

    <div class="column legal">
      <span class="foundation-name">{foundation.name}</span>
      <span>{foundation.address}</span>
      <span>KRS {foundation.krs}, REGON {foundation.regon}</span>
      <span>NIP {foundation.nip ?? "[DO UZUPEŁNIENIA]"}</span>

      <nav class="socials" aria-label="Media społecznościowe Bloom Studio">
        <a class="social-link" href={instagram.url}>
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="0.8"></circle>
          </svg>
          <span>Instagram</span>
        </a>
        <a class="social-link" href={facebook.url}>
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          >
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
          <span>Facebook</span>
        </a>
      </nav>
    </div>
  </div>

  {/*
    Regulamin joins this row once that page exists. A link to nowhere is
    worse than no link.
  */}
  <div class="container bottom">
    <span>&copy; {year} {studio.name}</span>
    <a href="/polityka-prywatnosci">Polityka prywatności</a>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 15px;
  }

  .columns {
    display: flex;
    flex-wrap: wrap;
    gap: 36px 64px;
    padding-block: 56px 32px;
    border-top: 1px solid var(--color-border);
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1 1 240px;
  }

  .pages {
    flex: 0 1 200px;
  }

  .legal {
    flex: 1 1 260px;
    font-size: 14px;
  }

  .logo-name {
    font-family: var(--font-heading);
    font-size: 28px;
    letter-spacing: 0.16em;
    line-height: 1;
    color: var(--color-text);
  }

  .logo-tagline {
    font-family: var(--font-heading);
    font-style: italic;
  }

  .address {
    margin-top: 8px;
  }

  .page-link {
    text-decoration: none;
  }

  .foundation-name {
    color: var(--color-text);
    font-weight: 700;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 24px;
    margin-top: 12px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .social-link svg {
    flex-shrink: 0;
  }

  .social-link:hover,
  .social-link:focus-visible {
    color: var(--color-accent);
  }

  .social-link:hover span,
  .social-link:focus-visible span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 16px 28px;
    border-top: 1px solid var(--color-border);
    font-size: 14px;
  }
</style>
