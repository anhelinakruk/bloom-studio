---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";

import dayanaPhoto from "../images/dayana-portret.jpg";
import basiaPhoto from "../images/basia-portret.jpg";

/*
  Two equal instructors, Dayana slightly ahead as the founder: she comes
  first and her certificates get their own panel. Only the three courses in
  the brief are listed; the rest waits for Dayana's list, not guesses.
*/
const certificates = [
  { name: "Kurs instruktorski Barre", details: "[organizator, rok]" },
  { name: "Pilates Reformer I", details: "[organizator, rok]" },
  { name: "Pilates Reformer III", details: "[organizator, rok]" },
  { name: "[DO UZUPEŁNIENIA: pozostałe certyfikaty]", details: "[organizator, rok]" },
];
---

<Base
  title="Instruktorki – Bloom Studio by Dayana"
  description="Dayana Radzimowska i Barbara Witkowska prowadzą zajęcia pilatesu, barre, stretchingu i tańca w Bloom Studio w Szewcach. Kim są, co prowadzą i jakie mają certyfikaty."
>
  <section class="page-head">
    <h1>Instruktorki</h1>
    <p class="muted lead">
      Zajęcia w Bloom prowadzą dwie instruktorki: Dayana w poniedziałki i środy, Basia we
      wtorki i czwartki.
    </p>
  </section>

  <section class="container profile">
    <div class="profile-photo">
      <Photo
        src={dayanaPhoto}
        alt="Dayana Radzimowska na tle zielonej ściany z logo Bloom Studio."
        sizes="(max-width: 760px) 100vw, 40vw"
      />
    </div>
    <div class="profile-text">
      <div class="name">
        <h2>Dayana Radzimowska</h2>
        <span class="subtle">założycielka studia</span>
      </div>
      <dl class="facts">
        <div>
          <dt>Prowadzi</dt>
          <dd>pilates na macie i na reformerze, barre, High Heels, taniec 10–13 lat</dd>
        </div>
        <div>
          <dt>Kiedy</dt>
          <dd>poniedziałki i środy</dd>
        </div>
      </dl>
      <p class="strong-text">
        Taniec jest ze mną od dzieciństwa. Dziś dzielę się nim jako instruktorka: uczę tańca
        dzieci i kobiety, prowadzę też pilates i barre. Mam za sobą kursy instruktorskie z barre
        i z pilatesu na reformerze.
      </p>
      <p class="strong-text">
        Na co dzień pracuję jako Account Manager w branży IT, kocham sport, a przede wszystkim
        jestem mamą. Bloom założyłam z myślą o kobietach, żeby miały miejsce, w którym zadbają o
        ciało i o ducha i mogą się rozwijać.
      </p>
      <p class="strong-text">
        Jeśli to Twój pierwszy raz na pilatesie, nic się nie stało. Pokażę, poprawię,
        powtórzymy.
      </p>
    </div>
  </section>

  <section class="panel">
    <div class="container certificates">
      <div class="section-head">
        <h2>Certyfikaty Dayany</h2>
        <p class="muted">Kursy instruktorskie, które Dayana ukończyła.</p>
      </div>
      <ul class="certificate-list">
        {
          certificates.map((item) => (
            <li class="certificate">
              <span class="certificate-name">{item.name}</span>
              <span class="subtle">{item.details}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container profile profile-reverse">
    <div class="profile-photo">
      <Photo
        src={basiaPhoto}
        alt="Barbara Witkowska na tle zielonej ściany z logo Bloom Studio."
        sizes="(max-width: 760px) 100vw, 40vw"
      />
    </div>
    <div class="profile-text">
      <div class="name">
        <h2>Barbara Witkowska</h2>
        <span class="subtle">instruktorka, na zajęciach Basia</span>
      </div>
      <dl class="facts">
        <div>
          <dt>Prowadzi</dt>
          <dd>pilates, stretching, Trening Spokojnego Umysłu, taniec 6–8 lat</dd>
        </div>
        <div>
          <dt>Kiedy</dt>
          <dd>wtorki i czwartki</dd>
        </div>
      </dl>
      <p class="strong-text">
        Na zajęciach jestem Basią. Zaczynałam od tańca i tańczę do dziś, najczęściej high heels.
        Taniec nauczył mnie czuć ciało, kontrolować ruch i poruszać się płynnie, i to przenoszę
        na swoje zajęcia.
      </p>
      <p class="strong-text">
        Pilates znalazłam, kiedy szukałam ruchu, który łączy pracę z ciałem ze skupieniem, i
        szybko go pokochałam. Od tamtej pory regularnie biorę udział w szkoleniach. Dla mnie
        pilates to coś więcej niż trening: świadoma praca z ciałem i z głową.
      </p>
      <p class="subtle">[DO UZUPEŁNIENIA: ukończone szkolenia Basi, jeśli chce je pokazać]</p>
    </div>
  </section>

</Base>

<style>
  /* --- Profil instruktorki --- */
  .profile {
    display: flex;
    align-items: center;
    gap: 72px;
    padding-block: 0 var(--space-section);
  }

  /* Basia's photo sits on the right, so the page alternates */
  /* Last section on the page: its own bottom gap down to the footer */
  .profile-reverse {
    flex-direction: row-reverse;
    padding-top: var(--space-section);
    padding-bottom: var(--space-section);
  }

  .profile-photo {
    flex: 0 1 440px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
  }

  .profile-text {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 20px;
    max-width: 620px;
  }

  .name {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
  }

  .facts div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 12px;
  }

  .facts dt {
    flex: 0 0 80px;
    color: var(--color-text-subtle);
  }

  .facts dd {
    flex: 1 1 240px;
    margin: 0;
  }

  /* --- Certyfikaty --- */
  .certificates {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: clamp(72px, 9vw, 112px);
  }

  .certificate-list {
    margin: 0;
    padding: 8px 28px;
    background: var(--color-card);
    border-radius: var(--radius-card);
    list-style: none;
  }

  .certificate {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
    padding-block: 16px;
  }

  .certificate + .certificate {
    border-top: 1px solid var(--color-border);
  }

  .certificate-name {
    font-family: var(--font-heading);
    font-size: 22px;
    line-height: 1.3;
  }

  /*
    Too narrow for photo and text side by side (portrait tablet and phone):
    both profiles stack the same way, photo first, aligned left.
  */
  @media (max-width: 880px) {
    .profile,
    .profile-reverse {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }

    .profile-photo {
      flex: none;
      width: 100%;
      max-width: 480px;
    }

    .profile-text {
      max-width: none;
    }
  }
</style>
